{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:deploy": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "lint": "eslint src e2e",
    "lint:fix": "eslint --fix src e2e",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e"
  },
  "lint-staged": {
    "*.{ts,vue}": "eslint --fix",
    "*.{ts,tsx,vue,js,json,css,md}": "prettier --write"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "axios": "^1.15.2",
    "echarts": "^6.1.0",
    "js-yaml": "^5.1.0",
    "json-editor-vue": "^0.18.1",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/runtime-dom": "^3.5.33",
    "@vue/test-utils": "^2.4.9",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "^17.4.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  }
}
